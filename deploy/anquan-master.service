[Unit]
Description=Anquan Security Center Master
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anquan
Group=anquan
WorkingDirectory=/data/anquan
Environment=ANQUAN_DATA_DIR=/data/anquan
Environment=ANQUAN_HTTP_ADDR=:10110
Environment=ANQUAN_UDP_ADDR=:55555
EnvironmentFile=-/etc/anquan-master.env
ExecStart=/usr/local/bin/anquan-master
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/anquan
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
